# macOS: XQuartz ships xauth in /opt/X11 (on Linux the default /usr/bin/xauth is used)
Match exec "test -x /opt/X11/bin/xauth"
    XAuthLocation /opt/X11/bin/xauth

# Root access to cluster nodes - uses xlence-id-ed25519 key
Match user root host xlence,xlence2,node*,ngs,licensebox,elenuar,licsrv,192.168.60.*,159.149.32.*
    IdentityFile ~/.ssh/xlence-id-ed25519
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    # Una sola connessione TCP per tutti i comandi: da fuori ateneo/VPN la protezione
    # anti-brute-force di xlence (iptables recent) rifiuta dalla 7a connessione in 300s.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

Host *
  ServerAliveInterval 60
  ForwardAgent yes
  # Compression yes

